{
  "extends": "../../configs/tsconfig-base/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "commonjs",
    "declaration": false,
    "sourceMap": false,
    "inlineSourceMap": true,
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2020"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
